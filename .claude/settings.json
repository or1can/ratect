{
  "permissions": {
    "allow": [
      "Bash(cargo fmt --all -- --check)",
      "Bash(cargo clippy --workspace --all-targets --all-features -- -D warnings)",
      "Bash(cargo test --workspace)",
      "Bash(cargo test --workspace --test cli -- --ignored)"
    ],
    "ask": [
      "Bash(git commit --amend*)",
      "Bash(git commit * --amend*)",
      "Bash(git -C * commit *--amend*)",
      "Bash(git push --force*)",
      "Bash(git push * --force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git -C * push *--force*)",
      "Bash(git reset --hard*)",
      "Bash(git -C * reset --hard*)",
      "Bash(git rebase *)",
      "Bash(git -C * rebase *)",
      "Bash(GIT_SEQUENCE_EDITOR=* git *rebase *)"
    ],
    "deny": [
      "Bash(git commit --no-verify*)",
      "Bash(git commit * --no-verify*)",
      "Bash(git push --no-verify*)",
      "Bash(git push * --no-verify*)",
      "Bash(git -C * --no-verify*)",
      "Bash(SKIP=* git *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/unfiltered-check-output.py"
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "claims": {
      "source": {
        "source": "git",
        "url": "https://github.com/or1can/claims.git"
      }
    }
  },
  "enabledPlugins": {
    "claims@claims": true
  }
}
