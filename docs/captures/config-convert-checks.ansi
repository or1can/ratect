# Check before use:
# Task 'test' runs container 'app' as its own, so under ratect the container's 'setup_commands' don't run — a task's own container has no readiness gate (see https://github.com/or1can/ratect/blob/main/docs/dependency-readiness.md#the-tasks-own-container).
# Container 'app' has a volume host path '$HOME/.cache', which batect.yml uses as written but ratect evaluates as an expression — check what it resolves to under ratect.

ratect_version = "0.12.0"
project_name = "convert-fixture"

[containers.app]
image = "alpine:3.18.2"
volumes = ["$HOME/.cache:/cache"]

[[containers.app.setup_commands]]
command = "./warm-cache.sh"

[tasks.test]
description = "Runs the tests"

[tasks.test.run]
command = "./run-tests.sh"
container = "app"
